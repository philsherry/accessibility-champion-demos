    "eslint-plugin-html": "^8.1.0",
    "eslint-plugin-playwright": "^2.0.0",
    "globals": "^15.0.0",
    "http-server": "^14.1.1",
    "postcss-html": "^1.7.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.0.0"
